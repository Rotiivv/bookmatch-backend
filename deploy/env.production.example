# Modelo do .env de producao. Na VPS ele fica em ~/bookmatch/.env
# (veja docs/deploy.md, fase 3). Esse arquivo nunca vai para o Git.
#
# Gere cada senha com:  openssl rand -hex 24
# (apenas letras e numeros: caracteres como @ ou / quebram a DATABASE_URL)

# Dominio publico da API. O DNS precisa apontar para a VPS.
API_DOMAIN=api-bookmatch.galpao.tech

# Banco de dados
MARIADB_DATABASE=bookmatch
MARIADB_USER=bookmatch
MARIADB_PASSWORD=troque-por-uma-senha-gerada
MARIADB_ROOT_PASSWORD=troque-por-outra-senha-gerada
