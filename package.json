{
  "name": "bookmatch-backend",
  "version": "0.0.1",
  "description": "API REST do BookMatch",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-node": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "mariadb": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.1",
    "light-my-request": "^6.8.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=26"
  }
}
